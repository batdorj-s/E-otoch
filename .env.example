# Gemini AI API Key
# Авах: https://ai.google.dev/
# Vercel-д суулгах: Project Settings → Environment Variables
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Chimege Voice Assistant Token
VITE_CHIMEGE_TOKEN=YOUR_CHIMEGE_TOKEN_HERE

# MongoDB Atlas Data API Configuration
# Хэрхэн үүсгэх: MongoDB Atlas -> App Services -> Data API -> Enable
VITE_MONGODB_DATA_API_URL=https://<region>.<provider>.data.mongodb-api.com/app/<app-id>/endpoint/data/v1
VITE_MONGODB_API_KEY=YOUR_MONGODB_ATLAS_DATA_API_KEY
VITE_MONGODB_DATASOURCE=Cluster0
VITE_MONGODB_DATABASE=e_otoch
